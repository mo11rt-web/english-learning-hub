# Firebase Web SDK config (من إعدادات المشروع في Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (لسكربت الـ seed فقط - لا يُستخدم في المتصفح)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# بديل أسهل على Vercel: ضع JSON كامل لحساب الخدمة في متغير واحد
FIREBASE_SERVICE_ACCOUNT_JSON=
# أو استخدم Base64 لقيمة JSON/المفتاح إذا كانت لوحة الاستضافة تغيّر الأسطر
FIREBASE_SERVICE_ACCOUNT_BASE64=
# أسماء بديلة مدعومة أيضًا: FIREBASE_ADMIN_SERVICE_ACCOUNT / FIREBASE_PRIVATE_KEY_BASE64

# Cloudinary — رفع الصور مجاناً بواجهة Unsigned Upload Preset، بديل Firebase Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
