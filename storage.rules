rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isTeacherOrAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    // ملفات الدروس (PDF، صور، صوت مرفوع يدويًا من المعلم): يرفعها المعلم فقط،
    // ويقرؤها أي مستخدم موثّق (التحكم بمن يراها فعليًا يتم عبر بيانات Firestore).
    match /lesson-files/{fileName} {
      allow read: if request.auth != null;
      allow write: if isTeacherOrAdmin();
    }

    // صور الإعلانات: يرفعها المعلم فقط، وتُقرأ للمستخدم الموثق أو قبل
    // تسجيل الدخول عبر رابط الإعلان العام المخزن في Firestore.
    match /announcements/{teacherId}/{fileName} {
      // getDownloadURL يولّد رابطاً موقّعاً يمكن عرضه للإعلان العام، أما
      // الوصول المباشر من Storage فيبقى للمستخدم الموثق فقط.
      allow read: if request.auth != null;
      allow write: if isTeacherOrAdmin() && request.auth.uid == teacherId && request.resource.size < 5 * 1024 * 1024;
    }

    // مرفقات الاستفسارات: الطالب يرفع داخل مجلده فقط، والطالب والمعلم
    // يستطيعان قراءة المرفق من خلال رابط السؤال.
    match /inquiry-files/{studentId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == studentId || isTeacherOrAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == studentId &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // ملفات صوت النطق المولّدة أو المرفوعة
    match /audio/{fileName} {
      allow read: if request.auth != null;
      allow write: if isTeacherOrAdmin();
    }
  }
}
